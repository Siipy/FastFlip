generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String    @id @default(uuid())
  sourceUrl  String
  title      String
  buyPrice   Decimal
  currency   String
  createdAt  DateTime  @default(now())
  marketData MarketData[]
  profitEstimates ProfitEstimate[]
}

model MarketData {
  id            String   @id @default(uuid())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  platform      String
  avgSoldPrice  Decimal
  minSoldPrice  Decimal
  maxSoldPrice  Decimal
  numSales      Int
  currency      String
  lastCheckedAt DateTime
}

model ProfitEstimate {
  id                     String   @id @default(uuid())
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId              String
  estimatedProfitPerItem Decimal
  profitMarginPercent    Decimal
  assumptionsJson        Json
  createdAt              DateTime @default(now())
}
